# Скопируй в .env и впиши свои значения. .env в git НЕ идёт.
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=            # свой chat_id (узнать: напиши боту, потом getUpdates)
BABY_DUE_DATE=2026-07-21     # предполагаемая дата родов (режим беременности)
BABY_BIRTH_DATE=            # впиши, когда родится → режим «недели жизни»
