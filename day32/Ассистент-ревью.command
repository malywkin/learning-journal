#!/bin/bash
# День 32 — ярлык-запускалка AI-ревьюера. Двойной клик в Finder → поднимает окно
# «положи diff → получи ревью» в браузере. Терминал трогать не нужно (можно свернуть).
# Закрыть — закрыть это окно терминала.

cd "$(dirname "$0")" || exit 1
PY="../day21/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "Не найдено окружение $PY — сначала подготовьте venv Дня 21."; read -r _; exit 1
fi

# Если порт занят прошлым запуском — освободить.
OLD=$(lsof -ti tcp:8320 2>/dev/null)
[ -n "$OLD" ] && kill "$OLD" 2>/dev/null && sleep 1

# Через 3 секунды (сервер успеет встать) открыть браузер.
( sleep 3; open "http://127.0.0.1:8320" ) &

echo "──────────────────────────────────────────────"
echo "  AI-ревьюер кода запущен."
echo "  Окно откроется в браузере автоматически."
echo "  Адрес: http://127.0.0.1:8320"
echo "  Чтобы закрыть — закройте это окно терминала."
echo "──────────────────────────────────────────────"

exec "$PY" app.py
