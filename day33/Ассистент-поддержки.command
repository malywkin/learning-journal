#!/bin/bash
# День 33 — ярлык-запускалка. Двойной клик в Finder → поднимает ассистента поддержки и
# открывает окно чата в браузере. Терминал трогать не нужно (можно свернуть).
# Закрыть ассистента: закрыть это окно терминала.

cd "$(dirname "$0")" || exit 1
PY="../day21/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "Не найдено окружение $PY — сначала подготовьте venv Дня 21."; read -r _; exit 1
fi

# Первый запуск: если индекса FAQ нет — собрать (займёт ~минуту).
if [ ! -f faq_index.db ]; then
  echo "Первый запуск: собираю индекс FAQ сервиса (~минуту)…"
  "$PY" -c "import docs_tool; docs_tool.build_index()"
fi

# Если порт занят прошлым запуском — освободить.
OLD=$(lsof -ti tcp:8033 2>/dev/null)
[ -n "$OLD" ] && kill "$OLD" 2>/dev/null && sleep 1

# Через 3 секунды (сервер успеет встать) открыть браузер.
( sleep 3; open "http://127.0.0.1:8033" ) &

echo "──────────────────────────────────────────────"
echo "  Ассистент поддержки «Поток» запущен."
echo "  Окно чата откроется в браузере автоматически."
echo "  Адрес: http://127.0.0.1:8033"
echo "  Чтобы закрыть — закройте это окно терминала."
echo "──────────────────────────────────────────────"

exec "$PY" app.py
